generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String    @id
  name         String
  email        String    @unique
  passwordHash String
  role         String
  label        String?
  initials     String?
  avatarColor  String?
  active       Boolean   @default(true)
  sortOrder    Int       @default(0)
  processes    Section[]
  createdAt    DateTime  @default(now())

  @@index([role])
}

model Godown {
  id       String    @id
  name     String
  location String
  products Product[]
}

model Product {
  id                String   @id @default(uuid())
  name              String
  spec              String?
  sku               String
  unit              String
  hsnCode           String   @default("")
  taxRate           Float    @default(18)
  section           Section
  godownId          String
  stock             Float    @default(0)
  costPrice         Float    @default(0)
  salePrice         Float
  lowStockThreshold Float    @default(5)
  updatedAt         DateTime @updatedAt
  godown            Godown   @relation(fields: [godownId], references: [id])

  @@index([section])
  @@index([godownId])
}

model TransferLog {
  id            String   @id @default(uuid())
  productId     String
  productName   String
  fromGodownId  String
  toGodownId    String
  qty           Float
  transferredAt DateTime @default(now())
  transferredBy String
}

model SalesBill {
  id              String      @id @default(uuid())
  billNumber      Int         @unique
  date            DateTime    @default(now())
  customerName    String?
  customerAddress String?
  customerPhone   String
  bookingDate     String?
  deliveryDate    String?
  transport       String?
  transportTime   String?
  section         Section
  subtotal        Float
  total           Float
  transportationAmount Float  @default(0)
  discount        Float       @default(0)
  paidAmount      Float       @default(0)
  status          BillStatus
  // "general" | "glass_plywood" — glass/plywood bills are created through a
  // separate flow (their own product picker, own numbering, own print
  // format eventually) but stay in this same table so revenue reporting
  // keeps working across both without any changes.
  billType        String      @default("general")
  // Independent invoice sequence for glass_plywood bills only (e.g.
  // "GP-2026-0001") — billNumber above is left untouched/unaffected for
  // every bill, general or glass_plywood, so the existing numbering never
  // has to change.
  gpVoucherNumber String?     @unique
  createdBy       String
  createdAt       DateTime    @default(now())
  items           SalesItem[]

  @@index([section])
  @@index([createdBy])
  @@index([date])
  @@index([billType])
}

model SalesItem {
  id          String    @id @default(uuid())
  billId      String
  productId   String
  productName String
  quantity    Float
  unit        String
  glassSize   String?
  model       String?
  sqFt        Float?
  unitPrice   Float
  subtotal    Float
  // Glass/plywood-only fabrication options — set of allowed values per field
  // is still being defined; columns exist now so the UI can start
  // collecting them.
  arch        String?
  polishSide  String?
  polishName  String?
  cornerType  String?
  hole        String?
  artWork     String?
  bill        SalesBill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([billId])
}

model PurchaseBill {
  id            String         @id @default(uuid())
  voucherNumber String         @unique
  vendorName    String
  date          DateTime
  section       Section
  godownId      String
  imageUrl      String?
  subtotal      Float
  total         Float
  transportationAmount Float @default(0)
  createdBy     String
  createdAt     DateTime       @default(now())
  printedAt     DateTime?
  items         PurchaseItem[]

  @@index([section])
}

model PurchaseItem {
  id            String       @id @default(uuid())
  purchaseId    String
  productId     String
  productName   String
  sizeDimension String?
  quantity      Float
  unit          String
  unitPrice     Float
  // What this item should be sold for once it's committed to inventory —
  // distinct from unitPrice (what we paid the vendor). Nullable so a new
  // product created from an item with no salePrice set falls back to
  // unitPrice (old behavior) instead of silently getting priced at 0.
  salePrice     Float?
  subtotal      Float
  godownId      String?
  purchase      PurchaseBill @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
}

/// Lowercase section keys, matching the frontend `Section` union.
enum Section {
  glass
  plywood
  plumbing
  painting
  electrical
  hardware
}

enum BillStatus {
  paid
  pending
  partial
}
